# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local — it is gitignored.
# These are the anon (public) key values used by createClient() on the
# client side; RLS policies, not secrecy of this key, are what protect data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
