# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local — it is gitignored.
# These are the anon (public) key values used by createClient() on the
# client side; RLS policies, not secrecy of this key, are what protect data.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Preview-only demo mode (see DECISIONS.md). Never set to true in
# Production. When true, LoginPage authenticates against a synthetic,
# hardcoded demoUsers directory (M001/K001/D001, PIN 2027) entirely
# client-side — no network call, no real Supabase project needed.
VITE_DEMO_MODE=false
